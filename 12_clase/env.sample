# =============================================================================
# Ortelana App - variables de entorno (SOLO secretos)
# =============================================================================
# Uso:  cp env.sample .env   y completar los valores.
# Las tres etapas (runtime, ingest, eval) leen este mismo archivo. Settings exige
# COHERE_API_KEY, MONGODB_URI y SUPABASE_KEY en todas: en ingest y eval alcanza un
# valor cualquiera para SUPABASE_KEY (no se usa).
# El .env no se versiona (.gitignore). Nunca subas claves reales.
# Todo lo que no es secreto (modelos, URLs, puertos, rutas) va en config.toml.
# =============================================================================


# -----------------------------------------------------------------------------
# GOOGLE_API_KEY  [obligatoria con llm.provider = "google"; siempre para la etapa eval]
# -----------------------------------------------------------------------------
# Para que se usa:
#   - LLM del sintetizador, agente ReAct y router (Gemini)
#   - Embeddings del indice vectorial (gemini-embedding-001)
#   - NeMo Guardrails (self check input/output con el modelo rapido)
#   - Juez de RAGAS en la etapa eval (siempre Gemini, aunque el provider sea cohere)
# Donde se obtiene: https://aistudio.google.com/app/apikey -> "Create API key"
GOOGLE_API_KEY=


# -----------------------------------------------------------------------------
# COHERE_API_KEY  [obligatoria]
# -----------------------------------------------------------------------------
# Para que se usa:
#   - Rerank del RAG hibrido (rerank-multilingual-v3.0), siempre
#   - LLM y embeddings si en config.toml pones llm.provider = "cohere"
# Donde se obtiene: https://dashboard.cohere.com/api-keys (alcanza la Trial key)
COHERE_API_KEY=


# -----------------------------------------------------------------------------
# MONGODB_URI  [obligatoria]
# -----------------------------------------------------------------------------
# Para que se usa:
#   - Leer el catalogo de origen (base "ortelana-app-database", coleccion "catalogo")
#     que la etapa ingest migra al indice vectorial (coleccion "knowledge_<provider>")
#   - Servir la busqueda vectorial (Atlas Vector Search) al runtime y a eval
#   - Guardar la memoria de las conversaciones (MongoDBSaver, base "ortelana-checkpoints")
# Es secreta porque incluye usuario y password.
# Donde se obtiene (Atlas): Database -> Connect -> Drivers -> copiar la connection string
#   y reemplazar <password>. El usuario necesita leer el catalogo y escribir checkpoints.
# Formato Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
# Formato local: mongodb://localhost:27017
MONGODB_URI=


# -----------------------------------------------------------------------------
# SUPABASE_KEY  [obligatoria]
# -----------------------------------------------------------------------------
# Para que se usa: consultar la tabla de CUIT (cuit_simulado) via REST.
# Donde se obtiene: Supabase -> Project Settings -> API Keys -> clave "anon" / "public".
#   Usar SOLO la anon key: la tabla tiene RLS con SELECT publico (10_clase/supabase).
#   Nunca la service_role key: saltea RLS y da acceso total a la base.
# La URL del proyecto NO va aca: va en config.toml -> [supabase] url.
SUPABASE_KEY=


# -----------------------------------------------------------------------------
# LANGSMITH_API_KEY  [opcional]
# -----------------------------------------------------------------------------
# Para que se usa: trazas en LangSmith (tokens, latencia, ruta del router).
# Si queda vacia, el tracing se desactiva solo y la app sigue funcionando.
# Proyecto y on/off van en config.toml -> [langsmith].
# Donde se obtiene: https://smith.langchain.com -> Settings -> API Keys -> "Create API Key"
LANGSMITH_API_KEY=


# -----------------------------------------------------------------------------
# SEARXNG_SECRET  [solo runtime/docker-compose.yaml]
# -----------------------------------------------------------------------------
# Para que se usa: clave interna de SearXNG (firma de cookies). La lee runtime/docker-compose.yaml.
# No se obtiene de ningun lado: es un texto aleatorio que generas vos, por ejemplo:
#   openssl rand -hex 32
SEARXNG_SECRET=
