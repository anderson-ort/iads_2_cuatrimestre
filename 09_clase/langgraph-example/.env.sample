# Copiar a .env en esta carpeta y completar:  cp .env.sample .env

# --- Gemini -----------------------------------------------------------------
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_google_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Límite de super-steps del grafo (cada vuelta agente -> herramientas = 2).
RECURSION_LIMIT=12

# --- LangSmith (opcional, igual que en la clase 08) --------------------------
# Con "true" cada ejecución del grafo queda como trace: se ve el ciclo
# agente -> herramientas -> agente, los tool_calls y cada ToolMessage.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=agente-ortelana-dev
