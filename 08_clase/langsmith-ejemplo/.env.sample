# Copiar a .env en esta carpeta y completar:  cp .env.sample .env

# --- Gemini (igual que ragas-ejemplo) ---------------------------------------
# Una sola key de Google AI Studio: LLM del RAG, LLM juez y embeddings del juez.
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_google_api_key

# --- LangSmith ---------------------------------------------------------------
# 1. Crear cuenta en https://smith.langchain.com (plan Developer, gratis).
# 2. Settings -> API Keys -> Create API Key (tipo "Personal Access Token").
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx
# Con "true", todo lo que pase por LangChain o por @traceable se envía como trace.
LANGSMITH_TRACING=true
# Proyecto (carpeta de traces) en la UI. Si no existe, LangSmith lo crea solo.
LANGSMITH_PROJECT=rag-ortelana-dev
# Solo si creaste la cuenta en la región EU; para US dejarlo comentado.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
