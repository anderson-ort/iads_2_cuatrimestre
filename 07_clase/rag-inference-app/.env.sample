# Copiar este archivo a .env y completar las claves reales.
#   cp .env.sample .env
# El .env no se versiona (esta en el .gitignore raiz).
# rag-inference-app/src/config.py lo carga automaticamente al importarse.

# LLM: router + generacion RAG (Gemini). Requerida para ejecutar la app.
GOOGLE_API_KEY=tu_google_api_key

# Embeddings con Google Gemini (opcional; solo si elegis ese provider).
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key

# Cohere: misma key para los embeddings de Cohere y para el reranker de Cohere.
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=tu_cohere_api_key

# HuggingFace no necesita clave: el modelo se descarga localmente.
